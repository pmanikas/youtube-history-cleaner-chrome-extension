{
  "manifest_version": 3,
  "name": "Watch History Cleaner for YouTube",
  "short_name": "History Cleaner",
  "version": "1.2.0",
  "homepage_url": "https://chromewebstore.google.com/detail/watch-history-cleaner-for/gmjbofkofpnflddoddjmcgaejcaofnoc",
  "description": "Bulk remove or find items in your YouTube watch history by type (All, Videos, Shorts, Music, Podcasts), keyword and date.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/cleaner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Watch History Cleaner for YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
